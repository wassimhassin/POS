  "components": {
    "schemas": {
      "BranchReport": {
        "required": [
          "id",
          "name",
          "businessId",
          "orderCount",
          "submittedCount",
          "submittedTotalMinor",
          "lastSequence",
          "lastSyncAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "businessId": {
            "type": "string"
          },
          "orderCount": {
            "type": "integer",
            "format": "int32"
          },
          "submittedCount": {
            "type": "integer",
            "format": "int32"
          },
          "submittedTotalMinor": {
            "type": "integer",
            "format": "int64"
          },
          "lastSequence": {
            "type": "integer",
            "format": "int64"
          },
          "lastSyncAt": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "BusinessReport": {
        "required": [
          "id",
          "name",
          "organizationId",
          "branches"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BranchReport"
            }
          }
        },
        "additionalProperties": false
      },
      "CloudError": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrganizationReport": {
        "required": [
          "id",
          "name",
          "businesses"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "businesses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessReport"
            }
          }
        },
        "additionalProperties": false
      },
      "RegisterGatewayRequest": {
        "required": [
          "code",
          "branchId",
          "publicKey",
          "signature"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "branchId": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterGatewayResponse": {
        "required": [
          "gatewayId",
          "organizationId",
          "organizationName",
          "businessId",
          "businessName",
          "branchId",
          "branchName"
        ],
        "type": "object",
        "properties": {
          "gatewayId": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "businessId": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "branchId": {
            "type": "string"
          },
          "branchName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReportCatalog": {
        "required": [
          "branchId",
          "lastSequence",
          "products"
        ],
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string"
          },
          "lastSequence": {
            "type": "integer",
            "format": "int64"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncProduct"
            }
          }
        },
        "additionalProperties": false
      },
      "ReportOrder": {
        "required": [
          "branchId",
          "lastSequence",
          "order"
        ],
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string"
          },
          "lastSequence": {
            "type": "integer",
            "format": "int64"
          },
          "order": {
            "$ref": "#/components/schemas/SyncOrder"
          }
        },
        "additionalProperties": false
      },
      "SyncBatch": {
        "required": [
          "events"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncEvent"
            }
          }
        },
        "additionalProperties": false
      },
      "SyncBatchResult": {
        "required": [
          "lastAcceptedSequence",
          "outcomes",
          "rejected"
        ],
        "type": "object",
        "properties": {
          "lastAcceptedSequence": {
            "type": "integer",
            "format": "int64"
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncEventOutcome"
            }
          },
          "rejected": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRejection"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SyncCloudState": {
        "required": [
          "lastSequence"
        ],
        "type": "object",
        "properties": {
          "lastSequence": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "SyncEvent": {
        "required": [
          "sequence",
          "eventId",
          "type",
          "schemaVersion",
          "occurredAt",
          "terminalId",
          "order",
          "printStations",
          "catalog"
        ],
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "eventId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "occurredAt": {
            "type": "string"
          },
          "terminalId": {
            "type": [
              "null",
              "string"
            ]
          },
          "order": {
            "oneOf": [
              {
                "type": "null"
              },
