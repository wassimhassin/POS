{
  "openapi": "3.1.1",
  "info": {
    "title": "PosSaaS Cloud API",
    "description": "Branch gateway synchronization and read-only reports. Every error body is the envelope { \"code\", \"message\" }: clients act on `code`; `message` is human-readable (French). Out-of-scope and non-existent resources are both 404.",
    "version": "v1"
  },
  "paths": {
    "/v1/gateways/register": {
      "post": {
        "tags": [
          "Gateways"
        ],
        "summary": "Register a gateway with a one-time provisioning code and proof of key possession.",
        "operationId": "RegisterGateway",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterGatewayRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudError"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterGatewayResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudError"
                }
              }
            }
          }
        }
      }
    },
