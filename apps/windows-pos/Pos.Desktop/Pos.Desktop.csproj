<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin WPF host: window, WebView2, bridge transport. Business logic lives in Pos.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pos.Desktop</AssemblyName>
    <WebUiDist>$(MSBuildThisFileDirectory)..\..\pos-web\dist\</WebUiDist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pos.Core\Pos.Core.csproj" />
  </ItemGroup>

  <!-- Packaged React build is copied next to the exe and served from a virtual host (no dev server). -->
  <ItemGroup>
    <None Include="$(WebUiDist)**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="WarnMissingWebUi" BeforeTargets="Build" Condition="!Exists('$(WebUiDist)index.html')">
    <Warning Text="React UI build not found at $(WebUiDist). Run 'npm run build' in apps/pos-web (or scripts/build.ps1) first." />
  </Target>

</Project>
