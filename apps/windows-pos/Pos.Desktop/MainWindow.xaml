<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="POS — Prototype"
        Width="1366" Height="768" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F5F2">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <!-- Native fallback shown when the web UI cannot be started. -->
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F6F5F2">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ErrorTitle" FontSize="26" FontWeight="SemiBold" Foreground="#1C1B19" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorBody" Margin="0,12,0,0" FontSize="16" Foreground="#6B675F" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
