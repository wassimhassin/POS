<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-independent core: SQLite persistence, bridge dispatcher, structured logging. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WritePrinter P/Invoke pins the job buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pos.Core.Tests" />
  </ItemGroup>

</Project>
