<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Branch LAN gateway: authoritative shared-order store + print intents. Console app for development,
       Windows Service for deployment (UseWindowsService is a no-op when started from a console). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pos.Gateway</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\windows-pos\Pos.Core\Pos.Core.csproj" />
  </ItemGroup>

</Project>
